# ── the plan ─────────────────────────────────────────────────────────────────
# These are the defaults — every day equal, spread flat over waking hours.
# Anything in ~/.config/ccpace/config.toml overrides them (see load_config).
DAYS = ("mon", "tue", "wed", "thu", "fri", "sat", "sun")

# Share of the week each day gets, Mon=0 … Sun=6. Only the ratios matter; they
# are normalised over the actual window.
DAY_WEIGHT = dict.fromkeys(range(7), 1.0)

# How each day's share is spread over the clock: (from_hour, to_hour, fraction).
# The last block is the "prime" block the advice is phrased around.
SHAPE = dict.fromkeys(range(7), [(9, 24, 1.0)])

TOLERANCE = 2.0  # ± points of the weekly meter that still count as "on plan"

# The hour a "day" rolls over. With 2, Tuesday runs Tue 2am → Wed 2am, so a
# late night still counts toward the evening it began in, and a block may run
# past midnight ([18, 2]).
DAY_STARTS = 0.0

# The zone the plan's hours are written in, and the one every time is shown in.
# None is the machine's own. Times are naive wall-clock in this zone throughout.
TZ: ZoneInfo | None = None


def wall(ts: float | None = None) -> datetime:
    """An epoch time (default: now) as wall-clock in the plan's zone."""
    return datetime.fromtimestamp(time.time() if ts is None else ts, TZ).replace(tzinfo=None)


def anchor(t: datetime) -> datetime:
    """Calendar midnight of the plan-day `t` falls in; that day spans
    anchor + DAY_STARTS hours → anchor + DAY_STARTS + 24 hours."""
    return (t - timedelta(hours=DAY_STARTS)).replace(hour=0, minute=0, second=0, microsecond=0)


def fit(blocks) -> list[tuple[float, float, float]] | None:
    """Clock-hour blocks → hours since the anchor, in day order, fractions
    normalised. Hours before DAY_STARTS belong to the tail of the day, so
    [18, 2] becomes 18 → 26. None if they don't make a valid day."""
    try:
        out = []
        for a, b, f in blocks:
            a, b, f = float(a), float(b), float(f)
            a, b = (a if a >= DAY_STARTS else a + 24), (b if b > DAY_STARTS else b + 24)
            if not (0 <= a < b <= DAY_STARTS + 24 and f >= 0):
                return None
            out.append((a, b, f))
    except (TypeError, ValueError):
        return None
    out.sort()
    whole = sum(f for *_, f in out)
    if not out or whole <= 0 or any(p[1] > n[0] for p, n in zip(out, out[1:])):
        return None
    return [(a, b, f / whole) for a, b, f in out]

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "ccpace" / "config.toml"


def load_config(path: Path) -> None:
    """Overlay config.toml on the defaults above. A missing file is fine."""
    global TOLERANCE, DAY_STARTS, TZ
    try:
        cfg = tomllib.loads(path.read_text())
    except FileNotFoundError:
        return
    except (OSError, tomllib.TOMLDecodeError) as e:
        sys.exit(f"ccpace: {path}: {e}")

    def bad(msg):
        sys.exit(f"ccpace: {path}: {msg}")

    if (zone := cfg.get("timezone")) is not None:
        try:
            TZ = ZoneInfo(zone)
        except (KeyError, ValueError, TypeError, OSError):  # unknown, malformed, or no tz database here
            bad(f'timezone {zone!r} is not a zone this machine knows (expected e.g. "America/Los_Angeles")')

    def expand(table: str):
        # keys are day names, or the groups `weekday` / `weekend` / `all`;
        # a named day beats a group, a group beats `all`
        groups = {"all": range(7), "weekday": range(5), "weekend": (5, 6)}
        raw = cfg.get(table, {})
        if unknown := set(raw) - set(DAYS) - set(groups):
            bad(f"[{table}] has unknown key(s): {', '.join(sorted(unknown))}")
        for key in ("all", "weekday", "weekend", *DAYS):
            if key in raw:
                for i in groups.get(key, (DAYS.index(key),) if key in DAYS else ()):
                    yield i, key, raw[key]

    for i, key, w in expand("days"):
        if not isinstance(w, (int, float)) or w < 0:
            bad(f"days.{key} must be a number >= 0")
        DAY_WEIGHT[i] = float(w)
    if not any(DAY_WEIGHT.values()):
        bad("[days] can't all be zero")

    DAY_STARTS = cfg.get("day_starts", DAY_STARTS)
    if not isinstance(DAY_STARTS, (int, float)) or not 0 <= DAY_STARTS < 24:
        bad("day_starts must be an hour from 0 up to 24")
    for i in range(7):  # re-seat the defaults on the new day boundary
        SHAPE[i] = fit(SHAPE[i]) or [(DAY_STARTS, DAY_STARTS + 24, 1.0)]

    for i, key, blocks in expand("hours"):
        SHAPE[i] = fit(blocks) or bad(
            f"hours.{key} must be non-overlapping [from_hour, to_hour, fraction] blocks "
            f"inside one day ({DAY_STARTS:g}:00 to {DAY_STARTS:g}:00)")

    TOLERANCE = float(cfg.get("tolerance", TOLERANCE))


# Used only when the API reports no active window (nothing used yet this week).
FALLBACK_RESET_WEEKDAY, FALLBACK_RESET_HOUR = 5, 0  # Saturday 00:00 on the plan's clock

# ── plumbing ─────────────────────────────────────────────────────────────────
CREDS = Path.home() / ".claude" / ".credentials.json"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "ccpace" / "usage.json"
CACHE_TTL = 60
BACKOFF = 180  # seconds to leave the API alone after a 429 that doesn't say how long
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"

COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ
FRAME = True  # draw the box around the card; --plain turns this and COLOR off


def c(code: str, s: str) -> str:
    return f"\033[{code}m{s}\033[0m" if COLOR else s


def dim(s): return c("2", s)
def bold(s): return c("1", s)
def green(s): return c("32", s)
def yellow(s): return c("33", s)
def red(s): return c("31", s)


# Why a reading couldn't be fetched, and the exit code --strict gives each.
EXIT = {"expired": 2, "no_login": 3, "unreachable": 4, "rate_limited": 4}


def fetch_usage(force: bool) -> tuple[dict | None, float | None, str, str | None]:
    """Returns (payload, fetched_at, status, why). status is "ok" or a key of
    EXIT; on anything but "ok" the payload is the last cached one (None if
    there isn't one) and `why` says what went wrong."""
    cached = None
    try:
        cached = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        pass
    if cached and not force and time.time() - cached["fetched_at"] < CACHE_TTL:
        return cached["data"], cached["fetched_at"], "ok", None
    # told to back off: asking again (even with -f) only keeps the limit alive
    if cached and (wait := cached.get("retry_at", 0) - time.time()) > 0:
        return (cached["data"], cached["fetched_at"], "rate_limited",
                f"usage API is rate-limiting; trying again in {secs(wait + 1)}")

    try:
        token = json.loads(CREDS.read_text())["claudeAiOauth"]["accessToken"]
        req = urllib.request.Request(USAGE_URL, headers={
            "Authorization": f"Bearer {token}",
            "anthropic-beta": "oauth-2025-04-20",
            "Content-Type": "application/json",
            "User-Agent": "ccpace",
        })
        with urllib.request.urlopen(req, timeout=15) as r:
            data = json.loads(r.read())
    except (OSError, KeyError, ValueError) as e:
        status = "unreachable"
        if isinstance(e, urllib.error.HTTPError) and e.code == 401:
            status, why = "expired", "token expired — open `claude` once to refresh it"
        elif isinstance(e, urllib.error.HTTPError) and e.code == 429:
            status = "rate_limited"
            # hold off for as long as the API asks, or a few minutes if it doesn't say
            try:
                wait = min(max(float(e.headers.get("Retry-After", "")), 30), 3600)
            except ValueError:
                wait = BACKOFF
            why = f"usage API is rate-limiting; trying again in {secs(wait)}"
            if cached:
                try:
                    CACHE.write_text(json.dumps(cached | {"retry_at": time.time() + wait}))
                except OSError:
                    pass
        elif isinstance(e, (FileNotFoundError, KeyError)):
            status, why = "no_login", f"no Claude Code login found in {CREDS}"
        else:
            why = f"couldn't reach the usage API ({e})"
        return (cached or {}).get("data"), (cached or {}).get("fetched_at"), status, why

    now = time.time()
    try:
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        CACHE.write_text(json.dumps({"fetched_at": now, "data": data}))
    except OSError:
        pass
    record((data.get("seven_day") or {}).get("utilization") or 0.0, now, data.get("five_hour"))
    return data, now, "ok", None


def local(iso: str) -> datetime:
    """API timestamp → wall-clock in the plan's zone, snapped to the minute."""
    dt = datetime.fromisoformat(iso).astimezone(TZ).replace(tzinfo=None)
    return (dt + timedelta(seconds=30)).replace(second=0, microsecond=0)


# ── the curve ────────────────────────────────────────────────────────────────
class Plan:
    """Cumulative expected weekly % at any moment inside [start, reset]."""

    def __init__(self, start: datetime, reset: datetime):
        self.start, self.reset = start, reset
        self.segs: list[tuple[datetime, datetime, float]] = []
        day = anchor(start)
        while day + timedelta(hours=DAY_STARTS) < reset:
            for h0, h1, frac in SHAPE[day.weekday()]:
                a, b = day + timedelta(hours=h0), day + timedelta(hours=h1)
                lo, hi = max(a, start), min(b, reset)
                if hi > lo:  # clip to the window, keeping a proportional share
                    self.segs.append((lo, hi, DAY_WEIGHT[day.weekday()] * frac * ((hi - lo) / (b - a))))
            day += timedelta(days=1)
        self.total = sum(w for *_, w in self.segs) or 1.0

    @staticmethod
    def shape(day: datetime):
        return SHAPE[anchor(day).weekday()]

    def at(self, t: datetime) -> float:
        done = 0.0
        for a, b, w in self.segs:
            if t >= b:
                done += w
            elif t > a:
                done += w * ((t - a) / (b - a))
        return 100.0 * done / self.total

    def when(self, pct: float) -> datetime:
        """The first moment the plan reaches `pct` — `at`, inverted."""
        lo, hi = self.start, self.reset
        for _ in range(40):
            mid = lo + (hi - lo) / 2
            lo, hi = (lo, mid) if self.at(mid) >= pct else (mid, hi)
        return hi


# ── history ──────────────────────────────────────────────────────────────────
# Every live reading is appended here so "today" can be measured from what the
# meter actually said when the day began, rather than from the plan.
HISTORY = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "ccpace" / "history.jsonl"


def record(used: float, t: float, session: dict | None = None) -> None:
    try:
        HISTORY.parent.mkdir(parents=True, exist_ok=True)
        # a week is all that's ever read, and -w adds a line a minute: keep about two
        if HISTORY.exists() and HISTORY.stat().st_size > 4_000_000:
            HISTORY.write_text("".join(HISTORY.read_text().splitlines(keepends=True)[-20_000:]))
        with HISTORY.open("a") as f:
            # the session numbers ride along so the two meters can be related later
            f.write(json.dumps({"t": round(t), "used": used, "session": (session or {}).get("utilization"),
                                "session_resets": (session or {}).get("resets_at")}) + "\n")
    except OSError:
        pass


def readings(plan: Plan, now: datetime) -> list[tuple[datetime, float]]:
    """Logged readings from this window, oldest first, up to now."""
    out = []
    try:
        for line in HISTORY.read_text().splitlines():
            s = json.loads(line)
            t = wall(s["t"])
            if plan.start <= t <= now + timedelta(minutes=1):  # incl. the one just taken
                out.append((t, float(s["used"])))
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return sorted(out)


def day_start(now: datetime, plan: Plan) -> tuple[float | None, str]:
    """What the weekly meter read when today began, and how far to trust it.

    Returns (reading, caveat). The last reading before midnight is a floor
    (anything used after it and before midnight gets counted as today); with
    none, the first reading of today is used, which misses whatever came
    before it. (None, ...) means there is nothing to go on.
    """
    midnight = today_of(plan, now)[1]  # when today began
    if midnight <= plan.start:
        return 0.0, ""  # first day of the window: the meter started at zero
    before = after = None
    for t, v in readings(plan, now):
        if t < midnight:
            before = (t, v)
        elif after is None:
            after = (t, v)
    if before:
        t, v = before
        settled = midnight - t <= timedelta(hours=1) or (after and after[1] == v)
        return v, "" if settled else f"since {clock(t)}"
    if after:
        t, v = after
        return v, f"since {t:%-I:%M %p}"
    return None, "estimated from the plan"


# ── speed ────────────────────────────────────────────────────────────────────
# How fast the meter moved over a stretch, as a multiple of how fast the plan
# said it should: 1.0 is exactly the planned rate, 2.0 is twice it.
ON_PACE = 0.15                 # ± this much of the planned rate still counts as on pace
GAP = timedelta(minutes=90)    # readings further apart than this can only be interpolated roughly


def plan_days(plan: Plan, now: datetime):
    """The window's plan-days as (anchor, begins, ends, is_today), clipped to it.
    The hours between the reset and the first rollover (Sat 12-2am, say) go on
    the first full day's account rather than standing as a day of their own."""
    day, lead = anchor(plan.start), None
    while (begins := day + timedelta(hours=DAY_STARTS)) < plan.reset:
        begins, ends = max(begins, plan.start), min(begins + timedelta(days=1), plan.reset)
        today = day == anchor(now)
        if begins == plan.start and ends - begins < timedelta(hours=6):
            lead = (begins, today)
        elif today or ends - begins >= timedelta(hours=6):  # skip the sliver a reset leaves behind
            if lead:
                begins, today, lead = lead[0], today or lead[1], None
            yield day, begins, ends, today
        day += timedelta(days=1)


def today_of(plan: Plan, now: datetime) -> tuple[datetime, datetime, datetime]:
    """(anchor, begins, ends) of the plan-day `now` falls in."""
    for day, begins, ends, today in plan_days(plan, now):
        if today:
            return day, begins, ends
    begins = anchor(now) + timedelta(hours=DAY_STARTS)
    return anchor(now), begins, begins + timedelta(days=1)


def meter_at(log: list[tuple[datetime, float]], t: datetime) -> tuple[float, bool]:
    """What the meter read at `t`, interpolated between the readings either
    side of it, and whether that is a rough guess (they disagree across a gap).
    `log` must bracket `t`."""
    i = bisect.bisect_right([s for s, _ in log], t)
    (t0, v0), (t1, v1) = log[i - 1], log[min(i, len(log) - 1)]
    if v0 == v1 or t1 <= t0:
        return v0, False
    return v0 + (v1 - v0) * ((t - t0) / (t1 - t0)), t1 - t0 > GAP


def speeds(used: float, now: datetime, plan: Plan, bedtime: float) -> list[dict]:
    """What the meter moved against its budget, over the last hour and over
    each day of the window. `bedtime` is tonight's target for the meter."""
    # the meter starts the window at zero and reads `used` right now
    log = [(plan.start, 0.0), *((t, v) for t, v in readings(plan, now) if plan.start < t < now), (now, used)]

    def over(label: str, lo: datetime, hi: datetime, live: bool = False, **more) -> dict:
        (v0, r0), (v1, r1) = meter_at(log, lo), meter_at(log, hi)
        moved, planned = max(v1 - v0, 0.0), plan.at(hi) - plan.at(lo)
        budget = planned
        # a finished day is held to the plan. One still in play is held to the
        # rate that lands tonight's target from where the stretch began, so a
        # day spent catching up reads as on pace, not fast
        if live and bedtime - plan.at(lo) > 0.05:
            budget = planned * max(bedtime - v0, 0.0) / (bedtime - plan.at(lo))
        speed = min(moved / budget, 9.9) if budget > 0.05 else None  # no budget, nothing to measure against
        row = {"label": label, "from": lo, "to": hi, "used": moved, "planned": planned, "budget": budget,
               "meter": v1, "speed": speed, "rough": r0 or r1, **more}
        # where the week ends if the rest of it runs at this stretch's multiple
        # of the plan (so nights and quiet days stay quiet), and when it fills
        if more.get("recent") and planned > 0.05:
            pace = moved / planned
            row["thin"] = 0 < moved < 2  # the meter moves in whole points: one tick is no rate at all
            row["ends"] = v1 + pace * (100.0 - plan.at(hi))
            if row["ends"] > 100.0 and v1 < 100.0:
                row["full_at"] = plan.when(plan.at(hi) + (100.0 - v1) / pace)
        return row

    rows = [over(f"last {name}", max(now - timedelta(minutes=m), plan.start), now, live=True, recent=True)
            for name, m in (("15m", 15), ("1h", 60), ("6h", 360))]
    for day, begins, ends, today in plan_days(plan, now):
        # `target` is where the plan has the meter when the day closes
        if begins < now:
            rows.append(over(f"{day:%a}", begins, min(ends, now), live=today, today=today, target=plan.at(ends)))
        else:
            share = plan.at(ends) - plan.at(begins)
            rows.append({"label": f"{day:%a}", "from": begins, "to": ends, "speed": None, "ahead": True,
                         "planned": share, "budget": share, "target": plan.at(ends)})
    return rows


# ── advice ───────────────────────────────────────────────────────────────────
def analyse(used: float, now: datetime, plan: Plan, start: float | None = None, start_note: str = "") -> dict:
    day, midnight, eod = today_of(plan, now)  # midnight: when today began
    if start is None:
        start = plan.at(midnight)
    start = min(start, used)  # the meter only climbs within a window
    prime = SHAPE[day.weekday()][-1][0]
    prime_from = day + timedelta(hours=prime)
    evening = prime >= 15  # is the prime block an evening one?

    expected = plan.at(now)
    target = plan.at(eod)                      # tonight's bedtime number
    room = target - used                       # what's left to spend today
    prime_nominal = target - plan.at(prime_from)
    in_prime = now >= prime_from
    nominal_left = target - expected           # what the plan still expects today
    tomorrow = plan.at(min(eod + timedelta(days=1), plan.reset))

    if in_prime:
        mult = room / nominal_left if nominal_left > 0.05 else None
    else:
        mult = room / prime_nominal if prime_nominal > 0.05 else None

    return {
        "used": used, "expected": expected, "delta": used - expected,
        "bedtime_target": target, "room_today": room,
        "prime_nominal": prime_nominal, "prime_from": prime_from, "eod": eod,
        "in_prime": in_prime, "evening": evening, "multiplier": mult,
        "trickle_left": 0.0 if in_prime else plan.at(prime_from) - expected,
        "hours_left": (eod - now) / timedelta(hours=1),
        "tomorrow_target": tomorrow, "tomorrow_nominal": tomorrow - target,
        "week_over": eod >= plan.reset,
        # today's allowance runs from the day's real starting point to the bedtime target
        "day_start": start, "day_start_note": start_note,
        "day_allowance": target - start, "day_used": used - start,
    }


def verdict(a: dict) -> dict:
    """What to do now, as a headline and the reason for it. `tone` is go / ok
    (green), slow (amber) or stop (red); `more` holds any follow-up lines."""
    block = "tonight" if a["evening"] else "today"
    normal = "a normal evening" if a["evening"] else "a normal day"
    room, mult, delta = a["room_today"], a["multiplier"], a["delta"]

    if room <= 0:
        past = f"already {-room:.0f}% past" if room <= -0.5 else "right at"
        more = []
        if not a["week_over"]:
            left = a["tomorrow_target"] - a["used"]
            more.append(f"Anything more comes out of tomorrow, which is down to {max(left, 0):.0f}% "
                        f"(normally {a['tomorrow_nominal']:.0f}%).")
        return {"tone": "stop", "head": "Stop for today.",
                "body": f"You're {past} {block}'s bedtime target ({a['bedtime_target']:.0f}%).", "more": more}

    x = f"{mult:.1f}×" if mult is not None else "—"
    if a["in_prime"]:
        rate = room / a["hours_left"] if a["hours_left"] > 0 else 0
        by = "midnight" if a["eod"].hour == a["eod"].minute == 0 else \
            f"{a['eod']:%-I%p}".replace("AM", "am").replace("PM", "pm")
        body = f"Use {room:.0f}% by {by} — {rate:.1f}%/h, {x} the planned pace."
        if mult is None:  # the plan expects nothing more today (day off, or the last minutes)
            return {"tone": "ok", "head": "Nothing more planned.",
                    "body": f"{room:.0f}% of slack before the bedtime target.", "more": []}
        if delta > TOLERANCE:
            return {"tone": "slow", "head": "Slow down.", "body": body, "more": []}
        if delta < -TOLERANCE:
            return {"tone": "go", "head": "Go harder.", "body": body, "more": []}
        return {"tone": "ok", "head": "On plan.", "body": body, "more": []}

    usual = a["prime_nominal"]
    budget = f"{room:.0f}% vs the usual {usual:.0f}%"
    # what's left for the prime block if the pre-prime trickle carries on as planned
    keep = max(room - a["trickle_left"], 0)
    keep_x = f"{keep / usual:.1f}×" if usual > 0.05 else "—"
    trickling = a["trickle_left"] > 0.3
    if delta > TOLERANCE:
        until = f"{a['prime_from']:%-I%p}".replace("AM", "am").replace("PM", "pm")
        more = [f"Keep trickling at the planned rate and it drops to {keep_x}."] if trickling else []
        return {"tone": "slow", "head": f"Take it easy until {until}.",
                "body": f"Stop now and {block} is {x} {normal} ({budget}).", "more": more}
    if delta < -TOLERANCE:
        return {"tone": "go", "head": "Quiet so far.", "body": f"You can go {x} {block} ({budget}).", "more": []}
    if trickling:
        return {"tone": "ok", "head": "On plan.", "body": f"Keep the daytime trickle ({a['trickle_left']:.0f}%) "
                f"and {block} is {keep_x} {normal} ({keep:.0f}% vs the usual {usual:.0f}%).", "more": []}
    return {"tone": "ok", "head": "On plan.", "body": f"{block.capitalize()} is {x} {normal} ({budget}).", "more": []}


def facts(a: dict, now: datetime, plan: Plan, session: dict | None, speed: list[dict]) -> dict:
    """Everything either card shows, worked out once: the verdict, the speeds
    as %/h, the clocks, and the week day by day."""
    recent = {r["label"].removeprefix("last "): r for r in speed if r.get("recent")}

    def per_hour(r: dict) -> float:
        hours = (r["to"] - r["from"]) / timedelta(hours=1)
        return r["used"] / hours if hours > 0 else 0.0

    left = a["hours_left"]
    # `need` lands tonight's target from here; `planned` is what the plan itself
    # has left for today, spread over the same hours
    need = a["room_today"] / left if left > 0.05 and a["room_today"] > 0 else None
    planned = (a["bedtime_target"] - a["expected"]) / left if left > 0.05 else None
    lately = [{"name": n, "rate": per_hour(r), "rough": r["rough"], "thin": r.get("thin", False)}
              for n, r in recent.items()]
    # where the week ends at the pace of the last hour (or six, if the hour had no plan to measure by)
    pace = next((r for r in (recent.get("1h"), recent.get("6h")) if r and "ends" in r), None)

    days = []
    for r in (r for r in speed if not r.get("recent")):
        share = r["target"] - plan.at(r["from"])
        used = None if r.get("ahead") else r["used"]
        days.append({"label": r["label"], "from": r["from"], "today": bool(r.get("today")),
                     "used": used, "share": share, "rough": r.get("rough", False),
                     "over": used is not None and used > share + 0.5})

    busy = (session or {}).get("utilization")
    return {
        "verdict": verdict(a),
        "state": "on plan" if abs(a["delta"]) <= TOLERANCE else "over" if a["delta"] > 0 else "under",
        "block": "tonight" if a["evening"] else "today",
        "need": need, "planned": planned, "lately": lately,
        "pace": pace and {"ends": pace["ends"], "full_at": pace.get("full_at"), "thin": pace["thin"],
                          "per_plan": pace["used"] / pace["planned"]},
        "days": days,
        "session": busy, "session_resets": local(session["resets_at"]) if busy is not None
        and session.get("resets_at") else None,
    }


# ── rendering ────────────────────────────────────────────────────────────────
def clock(t: datetime) -> str:
    return t.strftime("%a %-I:%M %p")


def moment(t: datetime, now: datetime) -> str:
    """A time to come: to the minute when it's today, else the day and hour are enough."""
    return f"{t:%-I:%M %p}" if t.date() == now.date() else f"{t:%a %-I %p}"


def span(td: timedelta) -> str:
    m = max(int(td.total_seconds() // 60), 0)
    d, h, m = m // 1440, m % 1440 // 60, m % 60
    return f"{d}d {h}h" if d else f"{h}h {m}m" if h else f"{m}m"


ANSI = re.compile(r"\033\[[0-9;]*m")


def wrap(s: str, width: int) -> list[str]:
    """Word-wrap to `width` visible columns, carrying any colour over the break."""
    lines, line, n, on = [], "", 0, ""
    for word in s.split(" "):
        w = len(ANSI.sub("", word))
        if n and n + 1 + w > width:
            lines.append(line + ("\033[0m" if on else ""))
            line, n = on, 0
        line += (" " if n else "") + word
        n += w + (1 if n else 0)
        for code in ANSI.findall(word):
            on = "" if code == "\033[0m" else code
    return [*lines, line]


def card(title: str, aside: str, lines: list[str]) -> None:
    """Print `lines` in a box, title and aside set into the top edge. Without
    the box under --plain, or when the terminal is too narrow for it."""
    def width(s: str) -> int:
        return len(ANSI.sub("", s))

    inner = max(map(width, lines)) + 2
    if not FRAME or inner + 2 > shutil.get_terminal_size((10_000, 24)).columns:
        print(f"{title}  {aside}\n")
        print("\n".join(lines))
        return
    rule = "─" * max(inner - width(title) - width(aside) - 6, 1)
    print(f"{dim('╭─')} {title} {dim(rule)} {aside} {dim('─╮')}")
    for line in ["", *lines, ""]:
        print(f"{dim('│')}{line}{' ' * (inner - width(line))}{dim('│')}")
    print(dim(f"╰{'─' * inner}╯"))


# ── the picture ──────────────────────────────────────────────────────────────
# --png draws its own card rather than a screenshot of the terminal one: it is
# looked at shrunk in a chat feed, so the verdict is set large, the details
# small, and the week is a chart. The face is Geist, fetched once and cached;
# DejaVu Sans stands in if it can't be.
GEIST = "https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/Geist-{}.ttf"
WEIGHTS = {400: "Regular", 500: "Medium", 600: "SemiBold", 700: "Bold"}
BG, PANEL, TRACK, RULE, SHADE = "#0e1116", "#161b22", "#262c36", "#39414d", "#1b2230"
INK, SOFT, MUTED, FAINT = "#e6edf3", "#c9d1d9", "#8b949e", "#6e7681"
GOOD, WARN, BAD, BLUE, BLUE_DEEP = "#4ade80", "#ff9b3d", "#f85149", "#58a6ff", "#1f6feb"


def face_file(weight: int) -> str:
    """A cached Geist file for `weight`, fetched on first use; DejaVu if that fails."""
    name = WEIGHTS[weight]
    path = CACHE.parent / "fonts" / f"Geist-{name}.ttf"
    if not path.exists():
        try:
            with urllib.request.urlopen(GEIST.format(name), timeout=10) as r:
                data = r.read()
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(data)
        except OSError:
            return "DejaVuSans-Bold.ttf" if weight >= 600 else "DejaVuSans.ttf"
    return str(path)


def mix(a: str, b: str, t: float) -> str:
    """`a` laid over `b` at opacity `t`, as one opaque colour."""
    pa, pb = (tuple(int(h[i:i + 2], 16) for i in (1, 3, 5)) for h in (a, b))
    return "#" + "".join(f"{round(x * t + y * (1 - t)):02x}" for x, y in zip(pa, pb))


def poster(a: dict, now: datetime, plan: Plan, f: dict, notes: list[str], fetched_at: float | None, out) -> None:
    """The card as a PNG written to `out` (a path or a binary stream). Laid out
    on a 1200-wide grid, drawn at three times that and halved, so the edges
    come out smooth at 1800 pixels."""
    try:
        from PIL import Image, ImageDraw, ImageFont, features  # only this path pays for the import
    except ImportError:
        sys.exit("ccpace: --png needs Pillow; run ccpace through uv, which installs it")
    S, W, P = 3, 1200, 44
    tnum = {"features": ["tnum"]} if features.check("raqm") else {}  # figures that line up
    fonts: dict = {}
    ops: list = []  # drawn once the height is known

    def font(size: float, weight: int = 400):
        key = (size, weight)
        if key not in fonts:
            try:
                fonts[key] = ImageFont.truetype(face_file(weight), round(size * S))
            except OSError:
                fonts[key] = ImageFont.load_default(round(size * S))
        return fonts[key]

    def width(s: str, size: float, weight: int = 400) -> float:
        return font(size, weight).getlength(s, **tnum) / S

    def text(x: float, y: float, s: str, size: float, weight: int = 400, fill: str = INK, anchor: str = "ls") -> float:
        """Draw `s` with its baseline at y; returns the x where it ends."""
        ops.append(lambda d: d.text((x * S, y * S), s, font=font(size, weight), fill=fill, anchor=anchor, **tnum))
        return x + width(s, size, weight)

    def runs(x: float, y: float, parts: list[tuple], align: str = "left") -> None:
        """Several (text, size, weight, colour) runs on one baseline."""
        total = sum(width(t, z, w) for t, z, w, _ in parts)
        x = x - total if align == "right" else x - total / 2 if align == "center" else x
        for t, z, w, c in parts:
            x = text(x, y, t, z, w, c)

    def box(x: float, y: float, w: float, h: float, fill: str | None, r: float = 0, outline: str | None = None,
            line: float = 0) -> None:
        if w > 0 and h > 0:
            ops.append(lambda d: d.rounded_rectangle((x * S, y * S, (x + w) * S, (y + h) * S), r * S, fill=fill,
                                                     outline=outline, width=round(line * S)))

    def stroke(pts: list[tuple[float, float]], fill: str, w: float, dash: tuple[float, float] | None = None) -> None:
        if len(pts) < 2:
            return
        if not dash:
            ops.append(lambda d: d.line([(x * S, y * S) for x, y in pts], fill=fill, width=round(w * S), joint="curve"))
            return
        on, off = dash  # walk the line, pen down for `on`, up for `off`
        seg, run, down, spans = [pts[0]], 0.0, True, []
        for (x0, y0), (x1, y1) in zip(pts, pts[1:]):
            length = ((x1 - x0) ** 2 + (y1 - y0) ** 2) ** 0.5
            done = 0.0
            while done < length:
                step = min((on if down else off) - run, length - done)
                done += step
                run += step
                pt = (x0 + (x1 - x0) * done / length, y0 + (y1 - y0) * done / length)
                if down:
                    seg.append(pt)
                if run >= (on if down else off) - 1e-9:
                    if down:
                        spans.append(seg)
                    down, run, seg = not down, 0.0, [pt]
        if down and len(seg) > 1:
            spans.append(seg)
        for sp in spans:
            if on <= w:  # a dash no longer than it is wide reads as a dot
                x, y = sp[0]
                dot(x, y, w / 2, fill)
            else:
                ops.append(lambda d, sp=sp: d.line([(x * S, y * S) for x, y in sp], fill=fill, width=round(w * S)))

    def dot(x: float, y: float, r: float, fill: str, ring: str | None = None, ring_w: float = 0) -> None:
        ops.append(lambda d: d.ellipse(((x - r - ring_w) * S, (y - r - ring_w) * S, (x + r + ring_w) * S,
                                        (y + r + ring_w) * S), fill=ring or fill))
        if ring:
            ops.append(lambda d: d.ellipse(((x - r) * S, (y - r) * S, (x + r) * S, (y + r) * S), fill=fill))

    def wrapped(s: str, size: float, weight: int, room: float) -> list[str]:
        lines, line = [], ""
        for word in s.split():
            if line and width(f"{line} {word}", size, weight) > room:
                lines.append(line)
                line = word
            else:
                line = f"{line} {word}".strip()
        return [*lines, line] if line else lines

    def label(x: float, y: float, s: str, size: float = 18) -> None:
        text(x, y, s.upper(), size, 600, MUTED)

    used, exp, delta = a["used"], a["expected"], a["delta"]
    v, state = f["verdict"], f["state"]
    tone = {"go": GOOD, "ok": GOOD, "slow": WARN, "stop": BAD}[v["tone"]]
    left_x, inner = P, W - 2 * P

    # the header: whose meter, when, and how long the week has left
    age = "" if fetched_at is None else " · updated now" if (old := time.time() - fetched_at) < 60 else \
        f" · updated {span(timedelta(seconds=old))} ago"
    runs(left_x, 62, [("Claude Code", 20, 700, INK), (f"  ·  {clock(now)}{age}", 20, 400, MUTED)])
    runs(W - P, 62, [("week resets ", 20, 400, MUTED), (clock(plan.reset), 20, 600, INK),
                     (f" · {span(plan.reset - now)}", 20, 400, MUTED)], "right")

    # the verdict: what to do in big type, where the meter stands beside it
    y, side = 88, 340
    room = inner - 64 - side - 40
    body = wrapped(v["body"], 26, 400, room)
    more = [ln for m in v["more"] for ln in wrapped(m, 20, 400, room)]
    tall = max(64 + 18 + 35 * len(body) + 28 * len(more), 160)
    box(left_x, y, inner, tall + 56, PANEL, 16)
    top = y + 28 + (tall - (64 + 18 + 35 * len(body) + 28 * len(more))) / 2
    text(left_x + 32, top + 54, v["head"], 64, 500, tone)
    for i, ln in enumerate(body):
        text(left_x + 32, top + 64 + 18 + 26 + 35 * i, ln, 26, 400, SOFT)
    for i, ln in enumerate(more):
        text(left_x + 32, top + 64 + 18 + 35 * len(body) + 22 + 28 * i, ln, 20, 400, MUTED)
    sx, sy = W - P - 32 - side, y + 28 + (tall - 160) / 2
    word = {"under": "under plan", "over": "over plan", "on plan": "on plan"}[state]
    runs(sx, sy + 46, [(f"{abs(delta):.1f}", 52, 600, INK), (f"  {word}", 24, 400, SOFT)])
    box(sx, sy + 70, side, 12, TRACK, 6)
    span_ = 15.0  # the scale runs ±15 points; the middle band is the tolerance
    box(sx + side * (0.5 - TOLERANCE / span_ / 2), sy + 70, side * TOLERANCE / span_, 12, RULE)
    mark = GOOD if state != "over" else WARN
    dot(sx + side * (0.5 + max(min(delta, span_), -span_) / span_ / 2), sy + 76, 12, mark, PANEL, 4)
    for name, at, anchor in (("under", 0, "ls"), ("on plan", 0.5, "ms"), ("over", 1, "rs")):
        lit = name == state
        text(sx + side * at, sy + 112, name, 16, 600 if lit else 400, mark if lit else MUTED, anchor)
    text(sx, sy + 146, f"{used:.0f}% used · plan says {exp:.0f}%", 18, 400, MUTED)
    y += tall + 56 + 22

    # three tiles: today's allowance, the speed in %/h, and the clocks
    tw, th = (inner - 36) / 3, 250
    for i in range(3):
        box(left_x + i * (tw + 18), y, tw, th, PANEL, 14)
    x = left_x + 24
    bw = tw - 48

    label(x, y + 42, "today")
    share, spent = a["day_allowance"], a["day_used"]
    if share > 0.05:
        due = max(exp - a["day_start"], 0.0)
        over = spent > share
        hue = BAD if over else tone
        runs(x, y + 98, [(f"{spent:.0f}", 44, 700, INK), (f" / {share:.0f}%", 24, 400, MUTED)])
        box(x, y + 120, bw, 22, TRACK, 6)
        box(x, y + 120, bw * min(spent / share, 1), 22, hue, 6)
        box(x + bw * min(due / share, 1) - 1.5, y + 114, 3, 34, INK)
        text(x, y + 174, f"from {a['day_start']:.0f}%", 17, 400, MUTED)
        text(x + bw / 2, y + 174, f"by now {due:.0f}", 17, 400, MUTED, "ms")
        text(x + bw, y + 174, f"bed {a['bedtime_target']:.0f}%", 17, 400, MUTED, "rs")
        if over:
            runs(x, y + 218, [(f"{spent - share:.0f}% past", 20, 700, BAD), (" the bedtime target", 20, 400, SOFT)])
        else:
            runs(x, y + 218, [(f"{a['room_today']:.0f}% left", 20, 700, hue), (f" for {f['block']}", 20, 400, SOFT)])
    else:
        runs(x, y + 98, [(f"{spent:.0f}%", 44, 700, INK)])
        box(x, y + 120, bw, 22, BAD, 6)
        text(x, y + 174, f"began at {a['day_start']:.0f}%, past bed", 17, 400, MUTED)

    x += tw + 18
    label(x, y + 42, "speed now")
    rate = {d["name"]: d for d in f["lately"]}
    hour = rate.get("1h", {"rate": 0.0, "rough": False, "thin": False})
    need, planned = f["need"], f["planned"]
    parts = [(f"{hour['rate']:.1f}", 44, 700, INK), ("%/h", 24, 400, MUTED)]
    if need is not None:
        parts.append((f"  → {need:.1f}", 24, 600, BLUE))
    runs(x, y + 98, parts)
    top_rate = max([5.0, *(d["rate"] for d in f["lately"]), need or 0, planned or 0]) * 1.1
    px = lambda r: x + bw * min(r / top_rate, 1)  # noqa: E731
    text(x, y + 116, "0", 13, 400, FAINT)
    text(x + bw, y + 116, f"{top_rate:.0f}%/h", 13, 400, FAINT, "rs")
    box(x, y + 137, bw, 6, TRACK, 3)
    marks = []
    if need is not None:
        box(px(need) - bw * 0.03, y + 131, bw * 0.06, 18, BLUE_DEEP, 4)
        marks.append((px(need), "need", BLUE))
    if planned:
        box(px(planned) - 1, y + 128, 2, 24, MUTED)
        marks.append((px(planned), "plan", MUTED))
    for name, r in (("6h", 7), ("15m", 7), ("1h", 10)):
        if name in rate:
            dot(px(rate[name]["rate"]), y + 140, r, GOOD if name == "1h" else mix(GOOD, PANEL, 0.5),
                PANEL if name == "1h" else None, 3)
    marks.append((px(hour["rate"]), "1h", GOOD))
    marks.sort()
    for i in range(1, len(marks)):  # keep the little labels from landing on each other
        if marks[i][0] - marks[i - 1][0] < 38:
            marks[i] = (marks[i - 1][0] + 38, *marks[i][1:])
    for mx, name, hue in marks:
        text(min(mx, x + bw - 12), y + 168, name, 13, 500, hue, "ms")
    text(x, y + 196, " · ".join(f"{n} {('~' if d['rough'] else '')}{d['rate']:.1f}{'?' if d['thin'] else ''}"
                                for n, d in rate.items()), 17, 400, MUTED)
    if f["pace"]:
        ends = f["pace"]["ends"]
        hue = BAD if ends > 100 + TOLERANCE else WARN if ends < 100 - TOLERANCE else GOOD
        tail = f" · full {moment(f['pace']['full_at'], now)}" if ends > 100 + TOLERANCE and f["pace"]["full_at"] else " at reset"
        runs(x, y + 228, [("at this pace ", 20, 400, SOFT),
                          (f"{min(ends, 999):.0f}%{'?' if f['pace']['thin'] else ''}", 20, 700, hue),
                          (tail, 20, 400, SOFT)])

    x += tw + 18
    label(x, y + 42, "time left")
    runs(x, y + 96, [(f["block"], 20, 400, SOFT)])
    runs(x + bw, y + 96, [(span(a["eod"] - now), 36, 700, INK)], "right")
    if f["session"] is not None:
        runs(x, y + 144, [("session", 20, 400, SOFT), (f"  {f['session']:.0f}% used", 17, 400, MUTED)])
        if f["session_resets"]:
            runs(x + bw, y + 144, [(span(f["session_resets"] - now), 28, 600, INK)], "right")
        box(x, y + 158, bw, 8, TRACK, 4)
        box(x, y + 158, bw * min(f["session"] / 100, 1), 8, MUTED, 4)
    runs(x, y + 210, [("week", 20, 400, SOFT)])
    runs(x + bw, y + 210, [(span(plan.reset - now), 28, 600, INK)], "right")
    y += th + 22

    # the week: the meter against the plan, and each day against its share
    box(left_x, y, inner, 560, PANEL, 14)
    runs(left_x + 24, y + 34, [("THE WEEK", 16, 600, MUTED),
                               ("   meter vs plan · bars: what each day used vs its share", 16, 400, MUTED)])
    ox, oy = left_x + 24, y + 50
    X0, X1, Y0, Y1 = ox + 44, ox + 884, oy + 40, oy + 256
    t0, t1 = plan.start, plan.reset
    whole = (t1 - t0).total_seconds()

    def X(t: datetime) -> float:
        return X0 + (X1 - X0) * min(max((t - t0).total_seconds() / whole, 0), 1)

    pace = f["pace"]
    ends = pace["ends"] if pace else 100.0
    vmax = max(100.0, min(ends, 130.0))

    def Y(v: float) -> float:
        return Y1 - (Y1 - Y0) * min(max(v, 0), vmax) / vmax

    days = f["days"]
    bounds = [d["from"] for d in days] + [t1]
    for d, lo, hi in zip(days, bounds, bounds[1:]):
        if d["today"]:
            box(X(lo), Y0, X(hi) - X(lo), Y1 - Y0, SHADE)
    for g in (0, 50, 100):
        stroke([(X0, Y(g)), (X1, Y(g))], TRACK, 1)
        text(X0 - 8, Y(g) + 5, f"{g}", 14, 400, MUTED, "rs")
    for lo in bounds[1:-1]:
        stroke([(X(lo), Y0), (X(lo), Y1)], TRACK, 1)

    step = timedelta(minutes=20)
    ticks = [t0 + step * i for i in range(int(whole // step.total_seconds()) + 1)] + [t1]
    log = [(t0, 0.0), *((t, u) for t, u in readings(plan, now) if t0 < t < now), (now, used)]
    pts = [(X(t), Y(u)) for t, u in log]
    ops.append(lambda d: d.polygon([(x * S, y * S) for x, y in [*pts, (X(now), Y1), (X0, Y1)]],
                                   fill=mix(GOOD, PANEL, 0.12)))
    stroke([(X(t), Y(plan.at(t))) for t in ticks], MUTED, 2.5, (7, 6))
    later = [t for t in ticks if t > now]
    if pace:
        stroke([(X(now), Y(used))] + [(X(t), Y(used + pace["per_plan"] * (plan.at(t) - exp))) for t in later],
               WARN, 3, (2, 7))
    tonight = a["room_today"] > 0
    if tonight:
        eod = min(a["eod"], t1)
        stroke([(X(now), Y(used)), (X(eod), Y(a["bedtime_target"]))], BLUE, 3.5)
    stroke(pts, GOOD, 4)
    stroke([(X(now), oy + 30), (X(now), Y1)], FAINT, 1.5, (3, 4))
    stroke([(X(now), Y(used)), (X(now), Y(exp))], INK, 3)
    dot(X(now), Y(exp), 5, MUTED)
    if tonight:
        dot(X(min(a["eod"], t1)), Y(a["bedtime_target"]), 5, BLUE)
    dot(X(now), Y(used), 8, GOOD if state != "over" else WARN, PANEL, 3)
    caption = [("now ", 17, 600, INK), (f"{used:.0f}%", 17, 600, GOOD if state != "over" else WARN),
               (f" vs plan {exp:.0f}%", 17, 600, MUTED)]
    cw = sum(width(t, z, w) for t, z, w, _ in caption)
    runs(min(max(X(now), X0 + cw / 2), X1 - cw / 2), oy + 20, caption, "center")

    # the lines are named in the margin, by where they end, nudged apart
    names = [(Y(100), "plan → 100%", MUTED)]
    if pace:
        names.append((Y(ends), f"this pace → {min(ends, 999):.0f}%", WARN))
    if tonight:
        names.append((Y(a["bedtime_target"]), f"{f['block']} → {a['bedtime_target']:.0f}%", BLUE))
    names.sort()
    for i in range(1, len(names)):
        if names[i][0] - names[i - 1][0] < 24:
            names[i] = (names[i - 1][0] + 24, *names[i][1:])
    for ny, s, hue in names:
        text(X1 + 14, ny + 6, s, 16, 600, hue)

    # one bar per day under its stretch of the chart: a dashed outline for its share, filled by what it used
    base, tallest = oy + 430, max([1.0, *(max(d["share"], d["used"] or 0) for d in days)])
    k = 110 / tallest
    stroke([(X0, base), (X1, base)], RULE, 2)
    for d, lo, hi in zip(days, bounds, bounds[1:]):
        bx, bw_ = X(lo) + 10, X(hi) - X(lo) - 20
        if bw_ <= 4:
            continue
        top = base - d["share"] * k
        for edge in ([(bx, base), (bx, top), (bx + bw_, top), (bx + bw_, base)],):
            stroke(edge, "#4a5361", 2.5, (7, 5))
        hue = WARN if d["over"] else GOOD
        if d["used"] is not None:
            box(bx, base - d["used"] * k, bw_, d["used"] * k, hue, 6)
            text(bx + bw_ / 2, base - max(d["used"], d["share"]) * k - 10,
                 f"{'~' if d['rough'] else ''}{d['used']:.0f}", 20, 700, hue, "ms")
        mid = (X(lo) + X(hi)) / 2
        text(mid, oy + 458, d["label"], 17 if d["today"] else 16, 700 if d["today"] else 500,
             INK if d["today"] else FAINT if d["used"] is None else SOFT, "ms")
        text(mid, oy + 480, f"of {d['share']:.0f}", 15, 400, MUTED, "ms")
    box(X1 + 14, oy + 348, 18, 18, GOOD, 4)
    text(X1 + 40, oy + 363, "used", 15, 400, SOFT)
    stroke([(X1 + 14, oy + 380), (X1 + 32, oy + 380), (X1 + 32, oy + 398), (X1 + 14, oy + 398), (X1 + 14, oy + 380)],
           "#4a5361", 2, (4, 3))
    text(X1 + 40, oy + 395, "day's share", 15, 400, SOFT)
    y += 560

    # the small print, only when there is some
    small = [text_ for on, text_ in (
        (any(d["rough"] for d in days) or any(d["rough"] for d in f["lately"]), "~ gap in history"),
        (any(d["thin"] for d in f["lately"]), "? single tick"),
        (a["day_start_note"], f"today {a['day_start_note']}"),
    ) if on] + [f"! {n}" for n in notes]
    for ln in wrapped(" · ".join(small), 16, 400, inner) if small else []:
        y += 26
        text(left_x, y + 4, ln, 16, 400, MUTED)
    H = y + 36

    image = Image.new("RGBA", (W * S, round(H * S)))  # clear outside the rounded corners
    draw = ImageDraw.Draw(image)
    draw.rounded_rectangle((0, 0, W * S - 1, H * S - 1), 20 * S, fill=BG)
    for op in ops:
        op(draw)
    image = image.resize((W * S // 2, round(H * S / 2)), Image.LANCZOS)
    try:
        image.save(out, "PNG", optimize=True)
    except OSError as e:
        sys.exit(f"ccpace: can't write the image: {e}")


def render(a: dict, now: datetime, plan: Plan, f: dict, notes: list[str], fetched_at: float | None = None) -> None:
    """The terminal card: the week on two lines, three tiles, and the verdict
    last, nearest the prompt, where the eye lands."""
    WIDE = (20, 29, 20)  # the tiles' text widths: today, speed, time left
    T = sum(WIDE) + 3 * 4 + 2  # the row of them, borders and gaps included
    used, exp, delta = a["used"], a["expected"], a["delta"]
    tones = {"go": green, "ok": green, "slow": yellow, "stop": red}
    out: list[str] = []
    p = out.append

    def pct(x: float) -> str:
        return f"{x:.1f}" if x < 10 else f"{x:.0f}"

    def bar(frac: float, at: float | None, width: int, tone) -> str:
        """A bar filled to `frac`, with the point it was expected at struck through it."""
        fill = round(width * min(max(frac, 0.0), 1.0))
        cells = [tone("█")] * fill + [dim("░")] * (width - fill)
        if at is not None:
            cells[min(max(round(width * at), 0), width - 1)] = bold("┃")
        return "".join(cells)

    def width(s: str) -> int:
        return len(ANSI.sub("", s))

    def spread(left: str, right: str, n: int) -> str:
        return left + " " * max(n - width(left) - width(right), 1) + right

    def tile(name: str, rows: list[str], n: int) -> list[str]:
        top = dim(f"┌ {name} {'─' * (n - len(name))}┐")
        return [top, *(dim("│ ") + r + " " * max(n - width(r), 0) + dim(" │") for r in rows), dim(f"└{'─' * (n + 2)}┘")]

    # the week: where the meter is against the plan, and each day against its share
    tone = yellow if delta > TOLERANCE else green
    p(f"  {dim('week')}  {bar(used / 100, exp / 100, 40, tone)}  {bold(f'{used:.0f}%')}"
      + dim(f"  plan {exp:.0f}%  bed {a['bedtime_target']:.0f}%"))
    cells = []
    for d in f["days"]:
        n = "·" if d["used"] is None else ("~" if d["rough"] else "") + (pct(d["used"]) if 0 < d["used"] < 1 else f"{d['used']:.0f}")
        cell = f"{d['label']} {n}/{d['share']:.0f}"
        cells.append(yellow(cell) if d["over"] else bold(cell) if d["today"] else
                     dim(cell) if d["used"] is None else cell)
    p("        " + "  ".join(cells))
    p("")

    # today's allowance: from the meter's real starting point to the bedtime target
    share, spent = a["day_allowance"], a["day_used"]
    if share > 0.05:
        due = max(exp - a["day_start"], 0.0)
        over = spent > share
        t = red if over else tone
        today = [spread(bold(f"{spent:.0f}") + dim(f" of {share:.0f}%"),
                        t(f"{spent - share:.0f} past") if over else t(f"{a['room_today']:.0f} left"), WIDE[0]),
                 bar(spent / share, due / share, WIDE[0], t),
                 spread(dim(f"by now {due:.0f}"), dim(f"bed {a['bedtime_target']:.0f}%"), WIDE[0])]
    else:  # the day began at or past its bedtime target
        today = [spread(bold(f"{spent:.0f}%"), red("at target"), WIDE[0]), bar(1.0, None, WIDE[0], red),
                 dim(f"began at {a['day_start']:.0f}%")]

    # speed in %/h: what the last stretches ran at, against what tonight needs
    rate = {d["name"]: d for d in f["lately"]}

    def r(name: str) -> str:
        d = rate.get(name)
        return "·" if d is None else ("~" if d["rough"] else "") + f"{d['rate']:.1f}" + ("?" if d["thin"] else "")

    need = f"{f['need']:.1f}" if f["need"] is not None else "—"
    fast = []
    if f["pace"]:
        ends, unsure = f["pace"]["ends"], "?" if f["pace"]["thin"] else ""
        hot = ends > 100 + TOLERANCE
        fast = [(red if hot else green)(f"→ {min(ends, 999):.0f}%{unsure}")
                + dim(f" full {moment(f['pace']['full_at'], now)}" if hot and f["pace"]["full_at"] else " at reset")]
    speed = [spread(f"last hour {bold(r('1h'))}", f"need {bold(c('36', need))}", WIDE[1]),
             spread(dim(f"15m {r('15m')} · 6h {r('6h')}"), dim(f"plan {f['planned'] or 0:.1f}"), WIDE[1]),
             *(fast or [dim("no pace to project")])]

    # the clocks
    left = [spread(f["block"], bold(span(a["eod"] - now)), WIDE[2]),
            spread("session" + (dim(f" {f['session']:.0f}%") if f["session"] is not None else ""),
                   bold(span(f["session_resets"] - now)) if f["session_resets"] else dim("·"), WIDE[2]),
            spread("week", bold(span(plan.reset - now)), WIDE[2])]

    for row in zip(tile("today", today, WIDE[0]), tile("speed %/h", speed, WIDE[1]),
                   tile("time left", left, WIDE[2])):
        p("  " + " ".join(row))
    p("")

    # one line of caveats, only the ones in play
    marks = [text for on, text in (
        (any(d["rough"] for d in f["days"]) or any(d["rough"] for d in f["lately"]), "~ gap in history"),
        (any(d["thin"] for d in f["lately"]), "? single tick"),
        (a["day_start_note"], f"today {a['day_start_note']}"),
    ) if on]
    if marks:
        p(dim("  " + " · ".join(marks)))
    for n in notes:
        out.extend(dim(f"  {part}") for part in wrap(f"! {n}", T))
    if marks or notes:
        p("")

    # the verdict last: the state as a lit badge, then what to do about it
    v, state = f["verdict"], f["state"]
    label = state.upper() + (f" {abs(delta):.1f}" if abs(delta) >= 0.5 and state != "on plan" else "")
    lit = "1;7;33" if state == "over" else "1;7;32"
    head = tones[v["tone"]](bold(v["head"]))
    p(" " + (c(lit, f" {label} ") if COLOR else f"[{label}]") + "  " + head)
    for line in [v["body"], *v["more"]]:
        out.extend(f"  {part}" for part in wrap(line, T))

    age = "" if fetched_at is None else "updated now · " if (old := time.time() - fetched_at) < 60 else \
        f"updated {span(timedelta(seconds=old))} ago · "
    card(bold("Claude Code"), dim(f"{clock(now)} · {age}resets {clock(plan.reset)} ({span(plan.reset - now)})"), out)


def main() -> None:
    ap = argparse.ArgumentParser(description="Claude Code weekly usage vs. plan.")
    ap.add_argument("-f", "--fresh", action="store_true", help="ignore the 60s cache")
    ap.add_argument("-j", "--json", action="store_true", help="print JSON and exit")
    ap.add_argument("--used", type=float, help="what-if: pretend the weekly meter reads this")
    ap.add_argument("--now", type=datetime.fromisoformat,
                    help="what-if: pretend it is this time, on the plan's clock (its `timezone`, else local)")
    ap.add_argument("-c", "--config", type=Path,
                    help=f"plan file (default: $CCPACE_CONFIG, else {CONFIG})")
    ap.add_argument("--record", action="store_true", help="log a fresh reading and exit quietly (for cron)")
    ap.add_argument("-w", "--watch", type=float, nargs="?", const=CACHE_TTL, metavar="SECS",
                    help=f"redraw every SECS seconds (default: {CACHE_TTL}); r re-fetches now, q quits")
    ap.add_argument("--strict", action="store_true",
                    help="if the reading can't be fetched, say why on stderr and exit non-zero instead of "
                         "showing the cached one: 2 token expired, 3 no login, 4 unreachable or rate limited")
    ap.add_argument("--plain", action="store_true", help="no box and no colour, whatever the terminal")
    ap.add_argument("--png", metavar="FILE",
                    help="write the card as a PNG image to FILE (- for stdout) instead of printing it")
    args = ap.parse_args()
    load_config(args.config or Path(os.environ.get("CCPACE_CONFIG") or CONFIG))
    global COLOR, FRAME
    if args.plain:
        COLOR = FRAME = False
    if args.now and args.now.tzinfo:  # an offset pins the instant; put it on the plan's clock
        args.now = args.now.astimezone(TZ).replace(tzinfo=None)
    if args.record:
        args.fresh, args.used, args.now = True, None, None
    if args.png:
        if args.plain or args.json or args.record or args.watch is not None:
            ap.error("--png can't be combined with --plain, --json, --record or -w")
        show(args)
        return
    if args.watch is None:
        show(args)
        return
    if args.json or args.record:
        ap.error("-w can't be combined with --json or --record")
    if args.watch <= 0:
        ap.error("-w needs a positive number of seconds")

    # keys need a real terminal: cbreak hands them over unbuffered and unechoed,
    # and still leaves ctrl-c to the tty
    keys, fresh = sys.stdin.isatty(), args.fresh
    if keys:
        fd = sys.stdin.fileno()
        saved = termios.tcgetattr(fd)
        tty.setcbreak(fd)
    hint = "r to refresh now · q to quit" if keys else "ctrl-c to quit"
    try:
        while True:
            # draw into a buffer first so the screen never sits blank during a fetch
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                fetched_at = show(args)
            sys.stdout.write("\033[H\033[2J" + buf.getvalue())
            args.fresh = fresh
            due = time.monotonic() + args.watch
            # the footer ticks once a second: how old the numbers are, and when the next look is
            while (left := due - time.monotonic()) > 0:
                age = f"updated {secs(time.time() - fetched_at)} ago · " if fetched_at else ""
                sys.stdout.write("\r\033[K" + dim(f"  {age}next in {secs(left + 1)} · {hint}"))
                sys.stdout.flush()
                if not keys:
                    time.sleep(min(left, 1))
                elif select.select([fd], [], [], min(left, 1))[0]:
                    key = os.read(fd, 1).lower()
                    if key in (b"q", b""):
                        return
                    if key == b"r":
                        args.fresh = True  # this one redraw skips the cache
                        break
    except KeyboardInterrupt:
        pass
    finally:
        print()  # step off the footer line
        if keys:
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)


def secs(s: float) -> str:
    return f"{int(s)}s" if s < 120 else span(timedelta(seconds=s))


def show(args: argparse.Namespace) -> float | None:
    """Print the card (or JSON). Returns when the numbers were fetched, if they were."""
    notes, session = [], None
    now = args.now or wall()
    reset = fetched_at = status = why = None
    if args.used is None or args.now is None:
        data, fetched_at, status, why = fetch_usage(args.fresh)
        if why and (args.strict or data is None):  # nothing to show, or told not to show a stale one
            print(f"ccpace: {why}", file=sys.stderr)
            sys.exit(EXIT[status] if args.strict else 1)
        if why:
            notes.append(f"{why}; showing numbers from {secs(time.time() - fetched_at)} ago")
        week = data.get("seven_day") or {}
        session = data.get("five_hour")
        used = week.get("utilization") or 0.0
        if args.record:
            sys.exit(1 if why else 0)
        if week.get("resets_at"):
            reset = local(week["resets_at"])
    if args.used is not None:
        used, session = args.used, None

    if reset is None or not (reset - timedelta(days=7) <= now < reset):
        # no live window (or a what-if outside it): assume the usual reset slot
        reset = now.replace(hour=FALLBACK_RESET_HOUR, minute=0, second=0, microsecond=0)
        reset += timedelta(days=(FALLBACK_RESET_WEEKDAY - reset.weekday()) % 7)
        if reset <= now:
            reset += timedelta(days=7)

    plan = Plan(reset - timedelta(days=7), reset)
    a = analyse(float(used), now, plan, *day_start(now, plan))
    speed = speeds(float(used), now, plan, a["bedtime_target"])

    if args.json:
        # fetch: "ok", or why the reading shown is a cached one (null in a full what-if).
        # fetched_at carries its UTC offset; the other times are the plan's wall-clock
        stamp = fetched_at and datetime.fromtimestamp(fetched_at, TZ).astimezone(TZ)
        out = a | {"now": now, "resets_at": reset, "session": (session or {}).get("utilization"),
                   "notes": notes, "speed": speed, "fetch": status, "fetched_at": stamp, "stale": bool(why)}
        print(json.dumps(out, indent=2, default=datetime.isoformat))
        return fetched_at
    f = facts(a, now, plan, session, speed)
    if args.png:
        poster(a, now, plan, f, notes, fetched_at, sys.stdout.buffer if args.png == "-" else args.png)
    else:
        render(a, now, plan, f, notes, fetched_at)
    return fetched_at


if __name__ == "__main__":
    main()
